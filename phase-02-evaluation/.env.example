# ---------------------------------------------------------------------------
# Providers: gemini, openai or ollama (local, free, no rate limits)
# LLM_PROVIDER is used by the RAG (embeddings + answers).
# JUDGE_PROVIDER is used by the evaluation judge (empty = same as LLM_PROVIDER).
# ---------------------------------------------------------------------------

# Option A (recommended on a free Gemini key): Gemini for the RAG, local judge
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434

# Option B: everything local with Ollama (no API key at all)
# LLM_PROVIDER=ollama
# CHAT_MODEL=qwen3.5:9b
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIM=1024
# JUDGE_PROVIDER=
# JUDGE_MODEL=qwen3.5:9b

# Option C: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

OPENSEARCH_URL=http://localhost:9200
INDEX_NAME=rag-chunks
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
